{
  "manifest_version": 3,
  "name": "ICE Intelligence",
  "version": "1.0.0",
  "description": "Web3 实时威胁情报终端插件",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.iceintel.xyz/*",
    "http://localhost:8000/*",
    "https://etherscan.io/*",
    "https://*.etherscan.io/*",
    "https://bscscan.com/*",
    "https://*.bscscan.com/*",
    "https://polygonscan.com/*",
    "https://*.polygonscan.com/*",
    "https://solscan.io/*",
    "https://*.solscan.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ICE Intelligence — 安全事件上下文检测"
  },
  "content_scripts": [
    {
      "matches": [
        "https://etherscan.io/*",
        "https://*.etherscan.io/*",
        "https://bscscan.com/*",
        "https://*.bscscan.com/*",
        "https://polygonscan.com/*",
        "https://*.polygonscan.com/*",
        "https://solscan.io/*",
        "https://*.solscan.io/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}