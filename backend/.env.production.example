# ============================================================
# Web3 安全事件分析平台 · 生产环境环境变量 (示例/说明)
# 部署到 Render / Koyeb / 自有服务器时, 在平台的环境变量面板中
# 按需设置以下键值 (本文件仅为示例, 并非会被自动加载的 .env.production).
# ============================================================

# ---- 端口与绑定 (Render/Koyeb 自动注入 PORT, 一般无需手动设置) ----
# PORT=8000
# HOST=0.0.0.0

# ---- 数据库 (生产强烈推荐 PostgreSQL) ----
# SQLite 默认: sqlite:///./web3_security.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# 注意: 若使用 psycopg2 需在 backend/requirements.txt 取消注释 psycopg2-binary

# ---- 数据源 ----
# defillama = 对接 DefiLlama 真实公开接口 (api.llama.fi/hacks)
# simulate  = 模拟回退(仅在真实源不可用或本地演示时)
DATA_SOURCE=defillama

# DefiLlama 接口地址 (一般无需修改)
# DEFILLAMA_HACKS_URL=https://api.llama.fi/hacks

# ---- 定时抓取 ----
# 是否启用后台定时任务 (生产保持 true)
ENABLE_SCHEDULER=true
# 抓取间隔(秒), 默认每小时
FETCH_INTERVAL_SECONDS=3600
# 单轮真实抓取最多新入库事件数
FETCH_BATCH_SIZE=5
# 定时任务时区
SCHEDULER_TIMEZONE=Asia/Shanghai

# ---- 抓取失败重试 (指数退避: 10s → 20s → 40s) ----
FETCH_RETRY_TIMES=3
FETCH_RETRY_BACKOFF_SECONDS=10

# ---- 跨域 (CORS) ----
# "*" = 允许任意来源(公共 API)
# 若仅允许前端托管域名, 填逗号分隔域名列表, 例:
# CORS_ORIGINS=https://your-app.onrender.com,https://www.your-domain.com
CORS_ORIGINS=*

# ---- 日志 ----
LOG_LEVEL=INFO
# 日志目录(相对 backend/)
LOG_DIR=logs

# ---- 初始化 ----
# 首次启动是否自动填充历史演示数据(数据库为空时)
SEED_ON_STARTUP=true