# ===== Web3 Security Intelligence API 环境配置 =====

# 数据库连接串 (默认 SQLite, 复制本文件为 .env 后可修改)
# SQLite:     sqlite:///./web3_security.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/web3_security
DATABASE_URL=sqlite:///./web3_security.db

# 定时抓取间隔 (秒), 默认 1 小时 = 3600
FETCH_INTERVAL_SECONDS=3600

# 是否启用 APScheduler 定时任务 (true/false)
ENABLE_SCHEDULER=true

# 启动时是否自动填充 200 起历史事件 (true/false)
SEED_ON_STARTUP=true

# 定时任务时区 (IANA 标识)
SCHEDULER_TIMEZONE=Asia/Shanghai

# 数据源: defillama (真实公开接口) | simulate (模拟回退)
DATA_SOURCE=defillama

# 单次真实抓取最多新入库的事件数
FETCH_BATCH_SIZE=5

# DefiLlama Hacks 公共数据接口
DEFILLAMA_HACKS_URL=https://api.llama.fi/hacks

# 真实数据源失败重试次数与指数退避基数(秒): 第1次失败等10s, 第2次等20s, 第3次等40s
FETCH_RETRY_TIMES=3
FETCH_RETRY_BACKOFF_SECONDS=10

# 日志级别 (DEBUG/INFO/WARNING/ERROR) 与日志目录 (backend/logs/app.log)
LOG_LEVEL=INFO
LOG_DIR=logs

# CORS 允许的源, 逗号分隔, * 表示全部
CORS_ORIGINS=*
